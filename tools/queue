#!/usr/bin/env python3
"""Compute queue eligibility from source and content-bound gate evidence."""

import argparse
from collections import Counter
from dataclasses import dataclass
import json
import re
import sys

from failure_journal import JournalError, load_history, resume, suspension
from spec import (
    ROOT, SpecError, check_comment_header, has_runtime_entry, load_project, production_sources,
    phase0_input_paths, regular_file, snapshot_inputs,
)


@dataclass(frozen=True)
class State:
    status: str
    evidence: str


def unique_keys(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def no_nonfinite(value):
    raise ValueError(f"invalid JSON number: {value}")


def is_hash(value):
    return type(value) is str and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def evidence_status(project, spec):
    relative = f"build/evidence/{spec.name}.json"
    path = project.root / relative
    if not path.exists() and not path.is_symlink():
        return "absent"
    try:
        source = regular_file(project.root, relative, "gate evidence")
        with source.open(encoding="utf-8") as stream:
            record = json.load(stream, object_pairs_hook=unique_keys, parse_constant=no_nonfinite)
        if (type(record) is not dict or type(record.get("schema_version")) is not int
                or record["schema_version"] != 1):
            return "malformed (expected schema version 1)"
        scope = record.get("scope")
        if scope == "production-function":
            return "unsupported production evidence in the Phase 0 fixture report"
        if scope != "phase0-fixture":
            return "out of scope (expected function fixture evidence)"
        if (record.get("function") != spec.name or record.get("production_verified") is not False
                or record.get("outcome") not in ("pass", "fail")):
            return "malformed fixture identity or outcome"
        checks = record.get("checks")
        if (type(checks) is not dict or not checks or
                any(not name or type(result) is not dict or result.get("outcome") not in ("pass", "fail", "pending")
                    for name, result in checks.items())):
            return "malformed fixture checks"
        outcomes = {result["outcome"] for result in checks.values()}
        if (record["outcome"] == "pass" and ("pass" not in outcomes or "fail" in outcomes)
                or record["outcome"] == "fail" and "fail" not in outcomes
                and not (type(record.get("error")) is str and record["error"].strip())):
            return "inconsistent fixture outcome"
        toolchain = record.get("toolchain")
        if (type(toolchain) is not dict or not toolchain or any(
                not tool or type(identity) is not dict or not is_hash(identity.get("sha256"))
                or type(identity.get("version")) is not str or not identity["version"].strip()
                for tool, identity in toolchain.items())):
            return "malformed toolchain identity"
        inputs = record.get("inputs")
        required = {spec.path.as_posix(), "devenv.lock", "tools/gate.py"}
        if (type(inputs) is not dict or not required <= inputs.keys() or
                any(not is_hash(digest) for digest in inputs.values()) or
                not any(name.startswith("tests/fixtures/") for name in inputs) or
                not any(name.startswith("tests/unit/") for name in inputs)):
            return "missing or malformed content identities"
        try:
            # Validate every recorded relative path, even when the current
            # expected path set differs from the manifest.
            current = snapshot_inputs(project.root, inputs)
            expected = {path.as_posix() for path in phase0_input_paths(project.root)}
            if set(current) != expected:
                return "stale fixture evidence (input path set changed)"
        except (JournalError, SpecError, OSError) as error:
            return f"stale fixture evidence ({error})"
        changed = [name for name in current if inputs[name] != current[name]]
        if changed:
            return "stale fixture evidence (changed: " + ", ".join(changed) + ")"
        pending = sum(result["outcome"] == "pending" for result in checks.values())
        return f"fixture {record['outcome']} ({pending} pending checks; fixture only)"
    except (OSError, ValueError, RecursionError) as error:
        return f"malformed evidence ({error})"


def production_status(project, spec, implementation):
    relative = f"build/evidence/{spec.name}.production.json"
    path = project.root / relative
    if not path.exists() and not path.is_symlink():
        return False, evidence_status(project, spec)
    try:
        from production import REQUIRED_CHECKS, SUITE_CASES, phase2_inputs
        from runtime_gate import ERRNO, REQUIRED_CHECKS as RUNTIME_CHECKS
        from runtime_manifest_gate import (PLANS, REQUIRED_CHECKS as MANIFEST_CHECKS, STAT_ENGINE, WIDE_SPAN_ENGINE,
                                           check_stat_dependency_binding, manifest_dependency_bindings, manifest_inputs)

        source = regular_file(project.root, relative, "production evidence")
        with source.open(encoding="utf-8") as stream:
            record = json.load(stream, object_pairs_hook=unique_keys, parse_constant=no_nonfinite)
        if (type(record) is not dict or type(record.get("schema_version")) is not int
                or record["schema_version"] != 1 or record.get("function") != spec.name):
            return False, "malformed production evidence identity"
        scope = record.get("scope")
        manifest = spec.name in PLANS
        runtime = spec.name == ERRNO or manifest
        expected_scope = ("production-runtime-manifest-function" if manifest else
                          "production-runtime-function" if runtime else "production-function")
        if scope != expected_scope:
            return False, "production report has the wrong verification scope"
        if record.get("outcome") == "fail" and record.get("production_verified") is False:
            error = record.get("error")
            return False, f"production gate incomplete ({error})" if type(error) is str and error else (
                "malformed production gate failure")
        if record.get("outcome") != "pass" or record.get("production_verified") is not True:
            return False, "malformed production evidence outcome"

        checks = record.get("checks")
        required_checks = MANIFEST_CHECKS if manifest else RUNTIME_CHECKS if runtime else REQUIRED_CHECKS
        if type(checks) is not dict or not required_checks <= checks.keys():
            return False, "production evidence is missing required checks"
        for key, item in checks.items():
            if type(item) is not dict:
                return False, f"malformed production check {key}"
            if (key == "external_conformance" and spec.name not in SUITE_CASES
                    and item.get("outcome") == "not_applicable" and item.get("reason")):
                continue
            if item.get("outcome") != "pass":
                return False, f"production check {key} is incomplete"

        toolchain = record.get("toolchain")
        required_tools = {"nasm", "gcc", "qemu-x86_64", "valgrind"}
        required_tools |= {"ar", "make", "objdump"} if runtime else {"musl-gcc", "al-clang"}
        if manifest:
            required_tools.add("musl-gcc")
        if (type(toolchain) is not dict or not required_tools <= toolchain.keys() or any(
                type(item) is not dict or not is_hash(item.get("sha256"))
                or type(item.get("version")) is not str or not item["version"].strip()
                for item in toolchain.values())):
            return False, "malformed production toolchain identity"

        hashes = record.get("inputs")
        if type(hashes) is not dict or any(not is_hash(digest) for digest in hashes.values()):
            return False, "missing or malformed production input identities"
        current = manifest_inputs(spec.name) if manifest else phase2_inputs()
        if set(current) != set(hashes):
            return False, "stale production evidence (input path set changed)"
        changed = [name for name in current if hashes[name] != current[name]]
        if changed:
            return False, "stale production evidence (changed: " + ", ".join(changed) + ")"
        candidate = checks["candidate_build"]
        relative_source = implementation.relative_to(project.root).as_posix()
        artifact = "object_sha256" if runtime else "binary_sha256"
        if (candidate.get("source") != relative_source
                or candidate.get("source_sha256") != hashes.get(relative_source)
                or not is_hash(candidate.get(artifact))):
            return False, "production evidence does not bind the candidate"
        if manifest and PLANS[spec.name].private_engine == STAT_ENGINE:
            check_stat_dependency_binding(checks)
        if manifest and PLANS[spec.name].private_engine == WIDE_SPAN_ENGINE:
            from wide_span_production import check_span_dependency_binding
            check_span_dependency_binding(checks)
        if manifest and PLANS[spec.name].required_production:
            dependencies = manifest_dependency_bindings(PLANS[spec.name].required_production)
            if checks.get("production_dependencies") != dependencies:
                return False, "production dependency evidence has changed"
        return True, f"fresh {scope} pass"
    except (ImportError, OSError, ValueError, RecursionError) as error:
        return False, f"malformed or stale production evidence ({error})"


def states(project):
    sources = production_sources(project)
    result = {}
    for name, spec in project.functions.items():
        history = load_history(project.root, name)
        if history.blocked:
            result[name] = State("blocked", suspension(project.root, name, history))
            continue
        implementation = sources.get(name)
        if implementation is None:
            result[name] = State("todo", evidence_status(project, spec))
        else:
            check_comment_header(implementation, spec)
            verified, evidence = production_status(project, spec, implementation)
            result[name] = State("verified" if verified else "implemented", evidence)
    return result


def ready(spec, by_name):
    return by_name[spec.name].status == "todo" and all(
        dep in by_name and by_name[dep].status == "verified" for dep in spec.deps
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("next", help="print the first specified todo with verified dependencies")
    status = commands.add_parser("status", help="report computed state and evidence")
    status.add_argument("function", nargs="?")
    resume_command = commands.add_parser("resume", help="open a new reviewed attempt window")
    resume_command.add_argument("function")
    resume_command.add_argument("--reason", required=True)
    args = parser.parse_args()
    try:
        project = load_project(ROOT)
        if args.command == "resume":
            if args.function not in project.functions:
                raise SpecError(f"not a specified function: {args.function}")
            sequence = resume(project.root, args.function, args.reason)
            print(f"{args.function}: resumed at journal record {sequence}")
            return 0
        by_name = states(project)
        if args.command == "next":
            for name, spec in project.functions.items():
                if ready(spec, by_name):
                    print(name)
                    return 0
            print("queue: no eligible specified function", file=sys.stderr)
            return 1
        inventory = {item.name for item in project.inventory if has_runtime_entry(item)}
        names = by_name.keys()
        if args.function is not None:
            if args.function not in inventory:
                raise SpecError(f"not in the function inventory: {args.function}")
            names = (args.function,)
        for name in names:
            if name not in by_name:
                print(f"{name}: todo; specification pending")
                continue
            state = by_name[name]
            spec = project.functions[name]
            unmet = [dep for dep in spec.deps if dep not in by_name or by_name[dep].status != "verified"]
            dependency_note = ", ".join(unmet) if unmet else "none"
            print(f"{name}: {state.status}; unmet dependencies: {dependency_note}; evidence: {state.evidence}")
        if args.function is None:
            counts = Counter(state.status for state in by_name.values())
            counts["todo"] += len(inventory - by_name.keys())
            print(f"{len(by_name)}/{len(inventory)} functions specified; "
                  + ", ".join(f"{counts[kind]} {kind}" for kind in ("todo", "implemented", "verified", "blocked")))
    except (JournalError, SpecError, OSError) as error:
        print(f"queue: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
