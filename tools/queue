#!/usr/bin/env python3
"""Compute Phase 0 queue eligibility and classify available gate evidence."""

import argparse
from collections import Counter
from dataclasses import dataclass
import json
import re
import sys

from spec import (
    ROOT, SpecError, check_comment_header, load_project, production_sources,
    phase0_input_paths, regular_file, snapshot_inputs,
)


@dataclass(frozen=True)
class State:
    status: str
    evidence: str


def unique_keys(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def no_nonfinite(value):
    raise ValueError(f"invalid JSON number: {value}")


def is_hash(value):
    return type(value) is str and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def evidence_status(project, spec):
    relative = f"build/evidence/{spec.name}.json"
    path = project.root / relative
    if not path.exists() and not path.is_symlink():
        return "absent"
    try:
        source = regular_file(project.root, relative, "gate evidence")
        with source.open(encoding="utf-8") as stream:
            record = json.load(stream, object_pairs_hook=unique_keys, parse_constant=no_nonfinite)
        if (type(record) is not dict or type(record.get("schema_version")) is not int
                or record["schema_version"] != 1):
            return "malformed (expected schema version 1)"
        scope = record.get("scope")
        if scope == "production-function":
            return "unsupported production evidence (no complete production gate in Phase 0)"
        if scope != "phase0-fixture":
            return "out of scope (expected function fixture evidence)"
        if (record.get("function") != spec.name or record.get("production_verified") is not False
                or record.get("outcome") not in ("pass", "fail")):
            return "malformed fixture identity or outcome"
        checks = record.get("checks")
        if (type(checks) is not dict or not checks or
                any(not name or type(result) is not dict or result.get("outcome") not in ("pass", "fail", "pending")
                    for name, result in checks.items())):
            return "malformed fixture checks"
        outcomes = {result["outcome"] for result in checks.values()}
        if (record["outcome"] == "pass" and ("pass" not in outcomes or "fail" in outcomes)
                or record["outcome"] == "fail" and "fail" not in outcomes
                and not (type(record.get("error")) is str and record["error"].strip())):
            return "inconsistent fixture outcome"
        toolchain = record.get("toolchain")
        if (type(toolchain) is not dict or not toolchain or any(
                not tool or type(identity) is not dict or not is_hash(identity.get("sha256"))
                or type(identity.get("version")) is not str or not identity["version"].strip()
                for tool, identity in toolchain.items())):
            return "malformed toolchain identity"
        inputs = record.get("inputs")
        required = {spec.path.as_posix(), "devenv.lock", "tools/gate.py"}
        if (type(inputs) is not dict or not required <= inputs.keys() or
                any(not is_hash(digest) for digest in inputs.values()) or
                not any(name.startswith("tests/fixtures/") for name in inputs) or
                not any(name.startswith("tests/unit/") for name in inputs)):
            return "missing or malformed content identities"
        try:
            # Validate every recorded relative path, even when the current
            # expected path set differs from the manifest.
            current = snapshot_inputs(project.root, inputs)
            expected = {path.as_posix() for path in phase0_input_paths(project.root)}
            if set(current) != expected:
                return "stale fixture evidence (input path set changed)"
        except (SpecError, OSError) as error:
            return f"stale fixture evidence ({error})"
        changed = [name for name in current if inputs[name] != current[name]]
        if changed:
            return "stale fixture evidence (changed: " + ", ".join(changed) + ")"
        pending = sum(result["outcome"] == "pending" for result in checks.values())
        return f"fixture {record['outcome']} ({pending} pending checks; fixture only)"
    except (OSError, ValueError, RecursionError) as error:
        return f"malformed evidence ({error})"


def states(project):
    sources = production_sources(project)
    result = {}
    for name, spec in project.functions.items():
        if name in sources:
            check_comment_header(sources[name], spec)
        # Phase 0 does not recognize a complete production gate or production
        # failure history. A fixture pass can neither verify nor block a function.
        result[name] = State("implemented" if name in sources else "todo", evidence_status(project, spec))
    return result


def ready(spec, by_name):
    return by_name[spec.name].status == "todo" and all(
        dep in by_name and by_name[dep].status == "verified" for dep in spec.deps
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("next", help="print the first specified todo with verified dependencies")
    status = commands.add_parser("status", help="report computed state and evidence")
    status.add_argument("function", nargs="?")
    args = parser.parse_args()
    try:
        project = load_project(ROOT)
        by_name = states(project)
        if args.command == "next":
            for name, spec in project.functions.items():
                if ready(spec, by_name):
                    print(name)
                    return 0
            print("queue: no eligible specified function", file=sys.stderr)
            return 1
        inventory = {item.name for item in project.inventory if item.kind == "functions"}
        names = by_name.keys()
        if args.function is not None:
            if args.function not in inventory:
                raise SpecError(f"not in the function inventory: {args.function}")
            names = (args.function,)
        for name in names:
            if name not in by_name:
                print(f"{name}: todo; specification pending")
                continue
            state = by_name[name]
            spec = project.functions[name]
            unmet = [dep for dep in spec.deps if dep not in by_name or by_name[dep].status != "verified"]
            dependency_note = ", ".join(unmet) if unmet else "none"
            print(f"{name}: {state.status}; unmet dependencies: {dependency_note}; evidence: {state.evidence}")
        if args.function is None:
            counts = Counter(state.status for state in by_name.values())
            counts["todo"] += len(inventory - by_name.keys())
            print(f"{len(by_name)}/{len(inventory)} functions specified; "
                  + ", ".join(f"{counts[kind]} {kind}" for kind in ("todo", "implemented", "verified", "blocked")))
    except (SpecError, OSError) as error:
        print(f"queue: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
