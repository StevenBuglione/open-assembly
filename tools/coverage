#!/usr/bin/env python3
"""Report availability of source-mapped branch coverage."""

import argparse
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("function")
args = parser.parse_args()
print(f"{args.function}: pending source-mapped branch coverage (drcov or a QEMU plugin)",
      file=sys.stderr)
raise SystemExit(1)
