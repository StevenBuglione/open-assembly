#!/usr/bin/env python3
"""Verify source-mapped QEMU branch coverage on a production function."""

import argparse
import os
import re

from production import production
from runtime_gate import ERRNO, runtime_production
from runtime_manifest_gate import PLANS, runtime_manifest_production
from spec import IDENTIFIER, ROOT

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("function")
args = parser.parse_args()
if re.fullmatch(IDENTIFIER, args.function) is None:
    parser.error("invalid function name")
os.chdir(ROOT)
if args.function in PLANS:
    execute = runtime_manifest_production
elif args.function == ERRNO:
    execute = runtime_production
else:
    execute = production
raise SystemExit(execute(args.function, "coverage"))
