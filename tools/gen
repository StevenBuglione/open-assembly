def make_outputs(project, include_tracked=True, include_test=True):
    file_abi = load_file_abi(project.root)
    process_abi = load_process_abi(project.root)
    signal_abi = load_signal_abi(project.root)
    time_abi = load_time_abi(project.root)
    header_constants = {
        "unistd.h": file_abi["seek"],
        "fcntl.h": file_abi["open_flags"] | file_abi["descriptor_flags"],
        "sys/stat.h": file_abi["mode_bits"],
        "dirent.h": file_abi["dirent_types"],
        "sys/wait.h": process_abi["wait_flags"],
        "spawn.h": process_abi["spawn_flags"],
        "pthread.h": PTHREAD_CREATION | PTHREAD_MUTEX_TYPES | PTHREAD_ONCE_CONSTANTS,
        "limits.h": PTHREAD_TSD_LIMITS,
        "threads.h": {"ONCE_FLAG_INIT": 0, "TSS_DTOR_ITERATIONS": PTHREAD_TSD_LIMITS["PTHREAD_DESTRUCTOR_ITERATIONS"]},
        "time.h": time_abi["constants"],
        "signal.h": signal_abi["signals"] | signal_abi["mask_operations"] | signal_abi["action_flags"] | signal_abi["info_codes"],
        "stdio.h": {name: value for name, value in file_abi["seek"].items() if name in SEEK_ORIGINS},
        "stdlib.h": {"EXIT_SUCCESS": 0, "EXIT_FAILURE": 1},
    }
    grouped = defaultdict(list)
    for spec in project.functions.values():
        grouped[spec.header].append(spec)
    grouped["limits.h"] = []
    outputs = {}
    for header, specs in sorted(grouped.items()):
        # Hex encoding preserves a distinct include guard for every valid path.
        guard = "OPEN_ASSEMBLY_" + header.encode().hex().upper()
        if include_tracked:
            lines = [f"; {MARKER}", f"%ifndef {guard}", f"%define {guard}", ""]
            if header == "unistd.h":
                lines.extend(f"%define {name} {value}" for name, value in POSIX_FDS.items())
                lines.extend(("", "extern environ:data", "extern optarg:data", "extern opterr:data",
                              "extern optind:data", "extern optopt:data"))
            elif header == "stdio.h":
                lines.extend(f"%define {name} {value}" for name, value in STDIO_CONSTANTS.items())
                lines.extend(("", "extern stdin:data", "extern stdout:data", "extern stderr:data", ""))
            elif header == "fenv.h":
                lines.extend(f"%define {name} {value}" for name, value in FENV_CONSTANTS.items())
                lines.extend(("%define FE_DFL_ENV -1", ""))
            elif header == "signal.h":
                lines.extend(("%define SIG_DFL 0", "%define SIG_IGN 1", "%define SIG_ERR -1", ""))
            elif header == "math.h":
                lines.extend(f"%define {name} {value}" for name, value in MATH_CONSTANTS.items())
                lines.append("")
            elif header == "locale.h":
                lines.extend(f"%define {name} {value}" for name, value in LOCALE_CONSTANTS.items())
                lines.append("")
            if header == "pthread.h":
                lines.extend(("%define PTHREAD_COND_INITIALIZER 0, 0, 0, 0",
                              "%define PTHREAD_MUTEX_INITIALIZER 0, 0, 0, 0", ""))
            if header == "threads.h":
                lines.extend(f"%define {name} {value}" for name, value in C_THREAD_CONSTANTS.items())
                lines.append("")
            if header in header_constants:
                lines.extend(f"%define {name} {value}" for name, value in header_constants[header].items())
                lines.append("")
            lines.extend(f"extern {nasm_name(spec.name)}" for spec in specs)
            lines.extend(("", "%endif", ""))
            outputs[ASM / (header[:-2] + ".inc")] = "\n".join(lines)
        if include_test:
            lines = [f"/* {MARKER} Test declarations only. */", f"#ifndef {guard}_C",
                     f"#define {guard}_C", "", "#include <stddef.h>", ""]
            if header in {"unistd.h", "sys/wait.h", "signal.h"}:
                lines.extend((f"typedef {process_abi['types']['pid_t']} pid_t;", ""))
            if header == "limits.h":
                lines.extend((*C_INTEGER_LIMITS, ""))
            elif header == "unistd.h":
                lines.extend(("typedef long ssize_t;", f"typedef {file_abi['types']['off_t']} off_t;", ""))
                lines.extend(f"#define {name} {value}" for name, value in POSIX_FDS.items())
                lines.extend(("", "extern char **environ;", "extern char *optarg;",
                              "extern int opterr, optind, optopt;", ""))
            elif header == "fcntl.h":
                lines.extend((f"typedef {file_abi['types']['mode_t']} mode_t;", ""))
