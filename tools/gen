            elif header == "setjmp.h":
                lines.extend(("#include <signal.h>", "", "typedef unsigned long jmp_buf[8];",
                              "typedef struct {", "    unsigned long __registers[8];",
                              "    int __save_mask;", "    unsigned int __padding;", "    sigset_t __mask;",
                              "} sigjmp_buf[1];", ""))
            elif header == "signal.h":
                lines.extend(("typedef int sig_atomic_t;", "typedef void (*__al_sighandler_t)(int);",
                              "typedef struct { unsigned long __bits[16]; } sigset_t;", "",
                              "typedef struct {", "    int si_signo, si_errno, si_code, __pad0;",
                              "    union {", "        struct { int pid; unsigned int uid; } sender;",
                              "        unsigned long __storage[14];", "    } __info;", "} siginfo_t;", "",
                              "struct sigaction {", "    union {", "        __al_sighandler_t handler;",
                              "        void (*action)(int, siginfo_t *, void *);", "    } __disposition;",
                              "    sigset_t sa_mask;", "    int sa_flags;", "    void (*sa_restorer)(void);", "};", "",
                              "#define sa_handler __disposition.handler", "#define sa_sigaction __disposition.action",
                              "#define si_pid __info.sender.pid", "#define si_uid __info.sender.uid", "",
                              "#define SIG_DFL ((__al_sighandler_t)0)", "#define SIG_IGN ((__al_sighandler_t)1)",
                              "#define SIG_ERR ((__al_sighandler_t)-1)", ""))
            elif header == "sys/wait.h":
                lines.extend(("#define WIFEXITED(status) (((status) & 0x7f) == 0)",
                              "#define WEXITSTATUS(status) (((status) >> 8) & 0xff)",
                              "#define WIFSIGNALED(status) ((unsigned int)(((status) & 0x7f) - 1) < 126)",
                              "#define WTERMSIG(status) ((status) & 0x7f)",
                              "#define WIFSTOPPED(status) (((status) & 0xff) == 0x7f)",
                              "#define WSTOPSIG(status) (((status) >> 8) & 0xff)",
                              "#define WIFCONTINUED(status) ((status) == 0xffff)", ""))
            elif header == "dirent.h":
                lines.extend(("typedef struct __al_DIR DIR;", "", "struct dirent {", "    unsigned long d_ino;",
