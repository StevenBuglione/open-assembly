def inttypes_format_macros():
    lengths = {8: "hh", 16: "h", 32: "", 64: "l"}
    formats = {"MAX": '"j"', "PTR": '"l"'}
    lines = []
    for width, length in lengths.items():
        formats[str(width)] = formats[f"LEAST{width}"] = f'"{length}"'
        prefix = f"__OPEN_ASSEMBLY_FAST{width}_FORMAT"
        formats[f"FAST{width}"] = prefix
        conditional = "#if"
        for actual, actual_length in lengths.items():
            if actual < width:
                continue
            lines.extend((f"{conditional} INT_FAST{width}_MAX == INT{actual}_MAX && "
                          f"UINT_FAST{width}_MAX == UINT{actual}_MAX",
                          f'# define {prefix} "{actual_length}"'))
            conditional = "#elif"
        lines.extend(("#else", f'# error "unsupported fast integer representation for {width} bits"', "#endif", ""))
    for family, conversions in (("PRI", "diouxX"), ("SCN", "dioux")):
        for suffix, prefix in formats.items():
            lines.extend(f'#define {family}{conversion}{suffix} {prefix} "{conversion}"'
                         for conversion in conversions)
        lines.append("")
    return lines


