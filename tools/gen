                              "typedef struct { unsigned long __opaque[2]; } pthread_condattr_t;",
                              "typedef unsigned int pthread_key_t;",
                              "typedef struct { unsigned long __opaque[4]; } pthread_mutex_t;",
                              "typedef struct { unsigned long __opaque[2]; } pthread_mutexattr_t;",
                              "typedef int pthread_once_t;", "",
                              "#define PTHREAD_COND_INITIALIZER { { 0 } }",
                              "#define PTHREAD_MUTEX_INITIALIZER { { 0 } }", ""))
            elif header == "threads.h":
                lines.extend(("#include <time.h>", "", "typedef struct __al_thread_control *thrd_t;",
                              "typedef int (*thrd_start_t)(void *);", "typedef void (*tss_dtor_t)(void *);",
