                lines.extend(("};", ""))
            if header in header_constants:
                lines.extend(f"#define {name} ({value})" for name, value in header_constants[header].items())
                lines.append("")
            if header == "stdlib.h" and "mbrtowc" in project.functions:
                lines.extend(("size_t __al_mb_cur_max(void);",
