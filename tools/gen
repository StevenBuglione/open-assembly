#!/usr/bin/env python3
"""Generate declarations and the API index from function specifications."""

import argparse
from collections import defaultdict
from pathlib import Path
import os
import sys
import tempfile

from spec import (POSIX_FDS, ROOT, SEEK_ORIGINS, STAT_FILE_KINDS, SpecError, comment_header, has_runtime_entry,
                  load_file_abi, load_process_abi, load_project, load_signal_abi, nasm_name)


MARKER = "Generated by tools/gen; edit spec/ instead."
ASM = Path("include/asm")
C = Path("build/include/c")
INDEX = Path("docs/api-index.md")
STDIO_CONSTANTS = {
    "EOF": -1, "BUFSIZ": 4096, "_IOFBF": 0, "_IOLBF": 1, "_IONBF": 2,
    "FOPEN_MAX": 16, "FILENAME_MAX": 4096,
}
FENV_CONSTANTS = {
    "FE_INVALID": 1, "FE_DIVBYZERO": 4, "FE_OVERFLOW": 8, "FE_UNDERFLOW": 16,
    "FE_INEXACT": 32, "FE_ALL_EXCEPT": 61, "FE_TONEAREST": 0,
    "FE_DOWNWARD": 1024, "FE_UPWARD": 2048, "FE_TOWARDZERO": 3072,
}


def make_outputs(project, include_tracked=True, include_test=True):
    file_abi = load_file_abi(project.root)
    process_abi = load_process_abi(project.root)
    signal_abi = load_signal_abi(project.root)
    file_constants = {
        "unistd.h": file_abi["seek"],
        "fcntl.h": file_abi["open_flags"] | file_abi["descriptor_flags"],
        "sys/stat.h": file_abi["mode_bits"],
        "dirent.h": file_abi["dirent_types"],
        "sys/wait.h": process_abi["wait_flags"],
        "signal.h": signal_abi["signals"] | signal_abi["mask_operations"] | signal_abi["action_flags"] | signal_abi["info_codes"],
        "stdio.h": {name: value for name, value in file_abi["seek"].items() if name in SEEK_ORIGINS},
    }
    grouped = defaultdict(list)
    for spec in project.functions.values():
        grouped[spec.header].append(spec)
    outputs = {}
    for header, specs in sorted(grouped.items()):
        # Hex encoding preserves a distinct include guard for every valid path.
        guard = "OPEN_ASSEMBLY_" + header.encode().hex().upper()
        if include_tracked:
            lines = [f"; {MARKER}", f"%ifndef {guard}", f"%define {guard}", ""]
            if header == "unistd.h":
                lines.extend(f"%define {name} {value}" for name, value in POSIX_FDS.items())
                lines.extend(("", "extern environ:data", "extern optarg:data", "extern opterr:data",
                              "extern optind:data", "extern optopt:data"))
            elif header == "stdio.h":
                lines.extend(f"%define {name} {value}" for name, value in STDIO_CONSTANTS.items())
                lines.extend(("", "extern stdin:data", "extern stdout:data", "extern stderr:data", ""))
            elif header == "fenv.h":
                lines.extend(f"%define {name} {value}" for name, value in FENV_CONSTANTS.items())
                lines.extend(("%define FE_DFL_ENV -1", ""))
            elif header == "signal.h":
                lines.extend(("%define SIG_DFL 0", "%define SIG_IGN 1", "%define SIG_ERR -1", ""))
            if header in file_constants:
                lines.extend(f"%define {name} {value}" for name, value in file_constants[header].items())
                lines.append("")
            lines.extend(f"extern {nasm_name(spec.name)}" for spec in specs)
            lines.extend(("", "%endif", ""))
            outputs[ASM / (header[:-2] + ".inc")] = "\n".join(lines)
        if include_test:
            lines = [f"/* {MARKER} Test declarations only. */", f"#ifndef {guard}_C",
                     f"#define {guard}_C", "", "#include <stddef.h>", ""]
            if header in {"unistd.h", "sys/wait.h", "signal.h"}:
                lines.extend((f"typedef {process_abi['types']['pid_t']} pid_t;", ""))
            if header == "unistd.h":
                lines.extend(("typedef long ssize_t;", f"typedef {file_abi['types']['off_t']} off_t;", ""))
                lines.extend(f"#define {name} {value}" for name, value in POSIX_FDS.items())
                lines.extend(("", "extern char **environ;", "extern char *optarg;",
                              "extern int opterr, optind, optopt;", ""))
            elif header == "fcntl.h":
                lines.extend((f"typedef {file_abi['types']['mode_t']} mode_t;", ""))
            elif header == "sys/stat.h":
                lines.extend(("#include <time.h>", "", f"typedef {file_abi['types']['mode_t']} mode_t;", "",
                              "struct stat {", "    unsigned long st_dev, st_ino, st_nlink;",
                              "    mode_t st_mode;", "    unsigned int st_uid, st_gid, __pad0;",
                              "    unsigned long st_rdev;", "    long st_size, st_blksize, st_blocks;",
                              "    struct timespec st_atim, st_mtim, st_ctim;",
                              "    unsigned long __reserved[3];", "};", "",
                              "#define st_atime st_atim.tv_sec", "#define st_mtime st_mtim.tv_sec",
                              "#define st_ctime st_ctim.tv_sec", ""))
                lines.extend(f"#define S_IS{kind}(mode) (((mode) & S_IFMT) == {mask})"
                             for kind, mask in sorted(STAT_FILE_KINDS.items()))
            elif header == "setjmp.h":
                lines.extend(("#include <signal.h>", "", "typedef unsigned long jmp_buf[8];",
                              "typedef struct {", "    unsigned long __registers[8];",
                              "    int __save_mask;", "    unsigned int __padding;", "    sigset_t __mask;",
                              "} sigjmp_buf[1];", ""))
            elif header == "signal.h":
                lines.extend(("typedef int sig_atomic_t;", "typedef void (*__al_sighandler_t)(int);",
                              "typedef struct { unsigned long __bits[16]; } sigset_t;", "",
                              "typedef struct {", "    int si_signo, si_errno, si_code, __pad0;",
                              "    union {", "        struct { int pid; unsigned int uid; } sender;",
                              "        unsigned long __storage[14];", "    } __info;", "} siginfo_t;", "",
                              "struct sigaction {", "    union {", "        __al_sighandler_t handler;",
                              "        void (*action)(int, siginfo_t *, void *);", "    } __disposition;",
                              "    sigset_t sa_mask;", "    int sa_flags;", "    void (*sa_restorer)(void);", "};", "",
                              "#define sa_handler __disposition.handler", "#define sa_sigaction __disposition.action",
                              "#define si_pid __info.sender.pid", "#define si_uid __info.sender.uid", "",
                              "#define SIG_DFL ((__al_sighandler_t)0)", "#define SIG_IGN ((__al_sighandler_t)1)",
                              "#define SIG_ERR ((__al_sighandler_t)-1)", ""))
            elif header == "sys/wait.h":
                lines.extend(("#define WIFEXITED(status) (((status) & 0x7f) == 0)",
                              "#define WEXITSTATUS(status) (((status) >> 8) & 0xff)",
                              "#define WIFSIGNALED(status) ((unsigned int)(((status) & 0x7f) - 1) < 126)",
                              "#define WTERMSIG(status) ((status) & 0x7f)",
                              "#define WIFSTOPPED(status) (((status) & 0xff) == 0x7f)",
                              "#define WSTOPSIG(status) (((status) >> 8) & 0xff)",
                              "#define WIFCONTINUED(status) ((status) == 0xffff)", ""))
            elif header == "dirent.h":
                lines.extend(("typedef struct __al_DIR DIR;", "", "struct dirent {", "    unsigned long d_ino;",
                              "    long d_off;", "    unsigned short d_reclen;", "    unsigned char d_type;",
                              "    char d_name[256];", "};", ""))
            elif header == "errno.h":
                lines.extend(("#include <asm/errno.h>", "", "#define errno (*__errno_location())", ""))
            elif header == "inttypes.h":
                lines.extend(("#include <stdint.h>", ""))
            elif header == "stdio.h":
                lines.extend(("#include <stdarg.h>", "", "typedef struct __al_FILE FILE;",
                              "typedef struct { long offset; unsigned int state[2]; } fpos_t;", ""))
                lines.extend(f"#define {name} ({value})" for name, value in STDIO_CONSTANTS.items())
                lines.extend(("", "extern FILE *stdin;", "extern FILE *stdout;", "extern FILE *stderr;", ""))
            elif header == "fenv.h":
                lines.extend(("typedef unsigned short fexcept_t;",
                              "typedef struct { unsigned char x87[28]; unsigned int mxcsr; } fenv_t;", ""))
                lines.extend(f"#define {name} ({value})" for name, value in FENV_CONSTANTS.items())
                lines.extend(("#define FE_DFL_ENV ((const fenv_t *)-1)", ""))
            if header in file_constants:
                lines.extend(f"#define {name} ({value})" for name, value in file_constants[header].items())
                lines.append("")
            for spec in specs:
                attributes = " __attribute__((returns_twice))" if spec.name in {"setjmp", "sigsetjmp"} else ""
                lines.append(f"{spec.prototype}{attributes};")
            if header == "setjmp.h" and any(spec.name == "setjmp" for spec in specs):
                lines.extend(("", "#define setjmp(env) (setjmp)(env)"))
            lines.extend(("", "#endif", ""))
            outputs[C / header] = "\n".join(lines)
    if include_tracked:
        for family, abi in (("files", file_abi), ("process", process_abi), ("signal", signal_abi)):
            guard = f"OPEN_ASSEMBLY_LINUX_X86_64_{family.upper()}"
            lines = [f"; {MARKER}", f"%ifndef {guard}", f"%define {guard}", ""]
            lines.extend(f"%define __AL_NR_{name.upper()} {number}" for name, number in abi["syscalls"].items())
            lines.extend(("", "%endif", ""))
            outputs[ASM / f"linux-x86_64-{family}.inc"] = "\n".join(lines)
        entry_count = sum(has_runtime_entry(item) for item in project.inventory)
        lines = [f"<!-- {MARKER} -->", "# Open Assembly API index", "",
                 "This index lists authored function specifications. For implementation state, run `tools/queue status`.", "",
                 f"Specs: {len(project.functions)} of {entry_count} "
                 "inventoried functions. The inventory covers C17, the named POSIX subset, runtime ABI entries, "
                 "and Linux compatibility extensions. "
                 "see [inventory scope](cookbook/specifications.md#inventory-scope).", "",
                 "| Function | Header | Prototype | Standard |", "| --- | --- | --- | --- |"]
        lines.extend(
            f"| [`{spec.name}`](../{spec.path.as_posix()}) | `<{spec.header}>` | `{spec.prototype}` | {', '.join(spec.standard)} |"
            for spec in project.functions.values()
        )
        outputs[INDEX] = "\n".join(lines + [""])
    return outputs


def safe_target(root, relative):
    target = root / relative
    current = target
    while current != root:
        if current.is_symlink():
            raise SpecError(f"{relative}: generated output must not use symbolic links")
        current = current.parent
    return target


def atomic_write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as target:
        temp = Path(target.name)
        try:
            target.write(data)
            target.close()
            temp.chmod(0o644)
            os.replace(temp, path)
        finally:
            temp.unlink(missing_ok=True)


def sync(project, check, include_tracked, include_test):
    outputs = make_outputs(project, include_tracked, include_test)
    dirs = ([ASM] if include_tracked else []) + ([C] if include_test else [])
    root = project.root
    changes, obsolete, errors = [], [], []
    for relative, content in outputs.items():
        target = safe_target(root, relative)
        data = content.encode("utf-8")
        previous = target.read_bytes() if target.exists() else None
        if previous != data:
            if check:
                errors.append(f"{'stale' if previous is not None else 'missing'} output: {relative}")
            elif previous is not None and MARKER.encode() not in previous.split(b"\n", 1)[0]:
                errors.append(f"refusing to overwrite non-generated file: {relative}")
            else:
                changes.append((target, data))
    for directory in dirs:
        for target in sorted(safe_target(root, directory).rglob("*")):
            relative = target.relative_to(root)
            safe_target(root, relative)
            if target.is_dir() or relative in outputs:
                continue
            if check:
                errors.append(f"unexpected output: {relative}")
            else:
                with target.open("rb") as source:
                    first = source.readline(256)
                if MARKER.encode() not in first:
                    errors.append(f"refusing to delete non-generated file: {relative}")
                else:
                    obsolete.append(target)
    if errors:
        raise SpecError("\n".join(errors))
    for target, data in changes:
        atomic_write(target, data)
    for target in obsolete:
        target.unlink()
    print(f"{'checked' if check else 'generated'} {len(outputs)} output(s) from {len(project.functions)} specification(s)")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="check exact output bytes and path set")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--comment-header", metavar="FUNCTION", help="write the NASM comment header to stdout")
    group.add_argument("--test-headers", action="store_true", help="process only ignored C test headers")
    group.add_argument("--tracked-only", action="store_true", help="process only tracked NASM includes and index")
    args = parser.parse_args()
    if args.check and args.comment_header:
        parser.error("--check cannot be used with --comment-header")
    try:
        project = load_project(ROOT)
        if args.comment_header:
            spec = project.functions.get(args.comment_header)
            if not spec:
                raise SpecError(f"no specification for {args.comment_header}")
            print(comment_header(spec), end="")
        else:
            sync(project, args.check, not args.test_headers, not args.tracked_only)
    except (SpecError, OSError) as error:
        print(f"gen: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
