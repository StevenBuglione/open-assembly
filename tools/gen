                lines.extend(f"#define {name} ({value})" for name, value in FENV_CONSTANTS.items())
                lines.extend(("#define FE_DFL_ENV ((const fenv_t *)-1)", ""))
            elif header == "math.h":
                lines.extend(("typedef float float_t;", "typedef double double_t;", ""))
                lines.extend(f"#define {name} ({value})" for name, value in MATH_CONSTANTS.items())
                lines.extend(("#define HUGE_VAL (__builtin_huge_val())",
                              "#define HUGE_VALF (__builtin_huge_valf())",
                              "#define HUGE_VALL (__builtin_huge_vall())",
                              "#ifndef INFINITY",
                              "#define INFINITY (__builtin_inff())",
                              "#endif",
                              "#ifndef NAN",
                              '#define NAN (__builtin_nanf(""))',
                              "#endif", ""))
                for helper in ("__al_fpclassify", "__al_signbit"):
                    for kind, suffix in (("float", "f"), ("double", ""), ("long double", "l")):
                        lines.append(f"int {helper}{suffix}({kind});")
                lines.extend((
                    "int __al_comparef(float, float);",
                    "int __al_compare(double, double);",
                    "int __al_comparel(long double, long double);",
                    "",
                    "#define fpclassify(x) (_Generic((x), float: __al_fpclassifyf, double: __al_fpclassify, long double: __al_fpclassifyl)(x))",
                    "#define signbit(x) (_Generic((x), float: __al_signbitf, double: __al_signbit, long double: __al_signbitl)(x))",
                    "#define isfinite(x) (fpclassify(x) >= FP_ZERO)",
                    "#define isinf(x) (fpclassify(x) == FP_INFINITE)",
                    "#define isnan(x) (fpclassify(x) == FP_NAN)",
                    "#define isnormal(x) (fpclassify(x) == FP_NORMAL)",
                    "#define __al_math_cmp(x, y) (_Generic(((x) + (y)), float: __al_comparef, double: __al_compare, long double: __al_comparel)((x), (y)))",
